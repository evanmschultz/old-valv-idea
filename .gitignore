# Local research and scratch
.tmp/
.cache/
.worklog/

# OS clutter
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and debug
*.log
.hylla/logs/

# Environment and local overrides
.env
.env.*
!.env.example

# Build outputs
valv
bin/*
!bin/agent-dispatch.sh
dist/
build/
out/

# Test and coverage artifacts
coverage.out
coverage*.out
cover.out
