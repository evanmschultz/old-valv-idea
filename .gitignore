*.prof
*.test

# Tooling artifacts
.gocache/

# Per-developer local overrides — never tracked.
# Project-shared .claude/ files (CLAUDE.md, agents, etc.) DO get tracked.
*.local.json
.claude/settings.local.json
# Ephemeral per-session lock written by Claude Code's scheduled-task /
# ScheduleWakeup mechanism. Session-PID-bound; never commit.
.claude/scheduled_tasks.lock
# Per-run dispatch audit traces + hook bytecode — transient, never tracked.
.claude/agent-runs/
.claude/hooks/__pycache__/
